# OpenCircle — Environment Variables
# Copy this file to .env and fill in the value.
# NEVER commit .env — it is in .gitignore.
#
# This app is Arc Mainnet only. Every other value (chain id, chain path,
# USDC contract, RPC URL, block explorer) is a constant in
# src/lib/circle-config.ts. The client key is the only thing configurable.

# Circle Modular Wallets — Client Key (production)
# Circle Console → Keys → Client Keys → create for the mainnet entity.
# A client key is designed to ship in a browser bundle; it is not a secret.
# Format: LIVE_CLIENT_KEY:<uuid>:<uuid>
VITE_CLIENT_KEY_MAINNET=
