# OpenCircle — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env — it is in .gitignore.

# ── Circle Modular Wallets (Testnet) ─────────────────────────────────────────
# Get from: Circle Console → Keys → Client Keys
# Starts with: TEST_API_KEY:...
VITE_CLIENT_KEY=

# Fixed URL — do not change
VITE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# ── Circle Modular Wallets (Mainnet) ─────────────────────────────────────────
# Get from: Circle Console → Keys → Client Keys (production key)
# Starts with: LIVE_API_KEY:...
# Leave empty to disable mainnet toggle.
VITE_CLIENT_KEY_MAINNET=
